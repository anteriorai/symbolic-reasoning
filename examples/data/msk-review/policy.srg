predicate fracture: "Does imaging confirm an unstable or displaced fracture?"
  label: "Displaced or unstable fracture"
  context: "Guideline PDF page 1. Criterion paraphrased from the visible guideline page. Missing documentation remains unknown."
  cite: [guideline_1]

predicate nonunion: "Is there non-union or malunion despite conservative treatment?"
  label: "Non-union or malunion"
  context: "Guideline PDF page 1. Criterion paraphrased from the visible guideline page. Missing documentation remains unknown."
  cite: [guideline_1]

