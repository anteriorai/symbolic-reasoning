predicate fracture_requested: "Does the clinical record request or plan treatment for a fracture?"
  label: "Fracture indication review requested?"
  context: "Use documented requests, treatment plans, or referrals in the clinical record. An incidental finding alone does not establish a requested service. Unrequested reviews are skipped without a clinical finding."

predicate degeneration_requested: "Does the clinical record request or plan treatment specifically for degenerative joint disease?"
  label: "Degenerative-joint review requested?"
  context: "Use documented requests, treatment plans, or referrals in the clinical record. An incidental finding alone does not establish a requested service. Unrequested reviews are skipped without a clinical finding."

predicate rehabilitation_requested: "Does the clinical record request or plan post-operative rehabilitation, including physical or occupational therapy?"
  label: "Post-op rehabilitation requested?"
  context: "Use documented requests, treatment plans, or referrals in the clinical record. An incidental finding alone does not establish a requested service. Unrequested reviews are skipped without a clinical finding."

predicate support_requested: "Does the clinical record request or plan recovery support, including discharge planning, home services, or facility placement?"
  label: "Recovery-support planning requested?"
  context: "Use documented requests, treatment plans, or referrals in the clinical record. An incidental finding alone does not establish a requested service. Unrequested reviews are skipped without a clinical finding."

define fracture_criteria: any(fracture, nonunion, complex_fracture)
  label: "Fracture indication"
  doc: "Supplied guideline criteria."

define alternatives: all(injections_failed, rehab_failed)
  label: "Both alternative therapies failed"
  doc: "Supplied guideline criteria."

define degeneration_criteria: all(advanced_degeneration, refractory_symptoms)
  label: "Degenerative changes and symptoms"
  doc: "Supplied guideline criteria."

define rehab_need: any(limited_rom, mobility_loss)
  label: "Functional need · either"
  doc: "Synthetic service-planning rule, not a guideline authorization standard."

define rehab_plan: all(hemodynamics, rehab_cleared, therapy_prescribed, participation)
  label: "Safe rehabilitation plan · synthetic"
  doc: "Synthetic service-planning rule, not a guideline authorization standard."

define support_need: any(needs_mobility_help, needs_dressing_help)
  label: "Support need · either"
  doc: "Synthetic service-planning rule, not a guideline authorization standard."

define home_criteria: all(support_need, home_ready, care_tasks, home_services)
  label: "Home support plan · synthetic"
  doc: "Synthetic service-planning rule, not a guideline authorization standard."

define facility_criteria: all(support_need, facility_ready, facility_plan, transport)
  label: "Facility support plan · synthetic"
  doc: "Synthetic service-planning rule, not a guideline authorization standard."

outcome approved: "Approved"
outcome needs_review: "Needs review"

path fracture_approved: fracture_requested => fracture_criteria => approved
path fracture_review: fracture_requested => fracture_criteria !=> needs_review
path degeneration_approved: degeneration_requested => degeneration_criteria => alternatives => approved
path degeneration_review: degeneration_requested => degeneration_criteria !=> needs_review
path alternatives_review: degeneration_requested => degeneration_criteria => alternatives !=> needs_review
path rehab_approved: rehabilitation_requested => rehab_need => rehab_plan => approved
path rehab_need_review: rehabilitation_requested => rehab_need !=> needs_review
path rehab_plan_review: rehabilitation_requested => rehab_need => rehab_plan !=> needs_review
path home_approved: support_requested => home_criteria => approved
path facility_approved: support_requested => home_criteria !=> facility_criteria => approved
path support_review: support_requested => home_criteria !=> facility_criteria !=> needs_review
