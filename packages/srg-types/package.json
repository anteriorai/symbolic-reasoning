{
  "name": "@anteriorai/srg-types",
  "version": "0.6.1",
  "private": false,
  "license": "Apache-2.0",
  "author": "Anterior, Inc.",
  "description": "TypeScript types for SRG (Symbolic Reasoning Graph) schema",
  "type": "module",
  "main": "./dist/index.js",
