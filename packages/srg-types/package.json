    "directory": "packages/srg-types"
  },
  "homepage": "https://github.com/anteriorai/symbolic-reasoning/tree/master/packages/srg-types#readme",
  "bugs": "https://github.com/anteriorai/symbolic-reasoning/issues",
  "engines": {
    "node": ">=22"
  }
