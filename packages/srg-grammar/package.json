{
  "name": "@anteriorai/srg-grammar",
  "version": "0.7.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Tree-sitter grammar for SRG (Symbolic Reasoning Graph) language",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./language-configuration.json": "./language-configuration.json"
  },
  "files": [
    "grammar.js",
    "tree-sitter-srg.wasm",
    "queries",
    "language-configuration.json",
    "README.md"
  ],
  "keywords": [
    "tree-sitter",
    "parser",
    "srg",
    "wasm",
    "grammar"
  ],
  "scripts": {
    "generate": "tree-sitter generate && tree-sitter build --wasm --docker",
    "prepack": "npm run generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope": "source.srg",
      "file-types": [
        "srg"
      ],
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anteriorai/symbolic-reasoning.git",
    "directory": "packages/srg-grammar"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.25.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
